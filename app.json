{
  "expo": {
    "name": "Twake Visio",
    "slug": "twake-visio",
    "scheme": "twakevisio",
    "version": "0.9.1",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withLocalNotificationsOnly",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00AD5C"
        }
      ],
      "expo-background-task"
    ],
    "android": {
      "package": "com.linagora.twakevisio",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "meet.linagora.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.linagora.twakevisio",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Twake Visio utilise la caméra pour la visioconférence.",
        "NSMicrophoneUsageDescription": "Twake Visio utilise le micro pour la visioconférence.",
        "UIBackgroundModes": ["audio"]
      }
    }
  }
}
