# Copier vers .release-secrets.env (ignoré par git), remplir, puis lancer :
#   scripts/setup-release-secrets.sh
#
# Les secrets GitHub sont en ÉCRITURE SEULE : ce fichier local est le seul
# moyen de les (re)poser, et les valeurs passent de votre machine à GitHub
# sans transiter par personne.
#
# « comme Drive » = valeur identique à celle de twake-drive-mobile : les deux
# applications partagent l'équipe Apple KUT463DS29, le dépôt match et le projet
# Firebase/Play.

# ── Signature Android — PROPRE à Twake Visio ──
# NE PAS réutiliser le keystore de Drive ni celui de l'ancien visio-mobile :
# une clé par application, et la perdre interdit toute mise à jour sur Play.
ANDROID_KEYSTORE_FILE=/chemin/absolu/vers/twake-visio-release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=twakevisio
ANDROID_KEY_PASSWORD=

# ── Distribution Android (Firebase App Distribution + Play) ──
# PROPRE à Twake Visio : enregistrer com.linagora.twakevisio dans Firebase.
FIREBASE_APP_ID=
# Compte de service GCP — le même que Drive si le projet est partagé.
GCP_SERVICE_ACCOUNT_FILE=/chemin/absolu/vers/gcp-service-account.json

# ── Signature et distribution iOS — TOUT comme Drive, même compte Apple ──
APPLE_TEAM_ID=KUT463DS29
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Soit le fichier .p8 (encodé automatiquement), soit le contenu déjà en base64 :
APP_STORE_CONNECT_API_KEY_FILE=/chemin/absolu/vers/AuthKey_XXXX.p8
#APP_STORE_CONNECT_API_KEY_CONTENT=

# fastlane match — dépôt chiffré des certificats et profils, le même que Drive.
MATCH_GIT_URL=
MATCH_PASSWORD=
# Clé SSH privée donnant à la CI un accès en LECTURE au dépôt match :
MATCH_DEPLOY_KEY_FILE=/chemin/absolu/vers/match_deploy_key
#MATCH_DEPLOY_KEY=
