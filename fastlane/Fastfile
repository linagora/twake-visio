# Les lanes de publication de Twake Visio, iOS et Android.
#
# **Un seul Fastfile à la RACINE, là où `twake-drive-mobile` en a deux —
# `ios/fastlane/` et `android/fastlane/`.** Ce n'est pas une préférence de
# rangement : ici `android/` et `ios/` sont gitignorés et régénérés par
# `expo prebuild` (voir `AGENTS.md`). Un Fastfile posé dedans disparaîtrait à la
# première régénération, et la CI échouerait sur un fichier manquant que
# personne n'aurait supprimé.
#
# Les lanes reçoivent donc leur répertoire de travail par `project_dir` /
# `workspace`, et se lancent depuis la racine :
#
#     bundle exec fastlane android distribute
#     bundle exec fastlane ios distribute
#
# Le runbook complet est dans `docs/ci-cd-signed-release.md` — VERSIONNÉ, à la
# différence de celui de Drive, qu'il a fallu ressortir de l'historique git
# alors que cinq fichiers le citaient.

APP_IDENTIFIER = "com.linagora.twakevisio"
XCODE_PROJECT = "TwakeVisio.xcodeproj"
XCODE_WORKSPACE = "TwakeVisio.xcworkspace"
XCODE_SCHEME = "TwakeVisio"

platform :android do
  desc "APK signé, distribué par Firebase App Distribution"
  lane :distribute do
    gradle(task: "assembleRelease", project_dir: "android")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      service_credentials_file: ENV["GOOGLE_APPLICATION_CREDENTIALS"],
      groups: "testers",
      release_notes: ENV["RELEASE_NOTES"].to_s.empty? ?
        "Build #{ENV['GITHUB_RUN_NUMBER'] || 'local'} — #{`git log -1 --pretty=%s`.strip}" :
        ENV["RELEASE_NOTES"]
    )
  end

  desc "AAB signé, envoyé sur la piste interne de Google Play"
  lane :release do
    gradle(task: "bundle", build_type: "Release", project_dir: "android")
    supply(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["SUPPLY_JSON_KEY_PATH"],
      package_name: APP_IDENTIFIER
    )
  end
end

platform :ios do
  # Provisionnement ponctuel : crée les profils `match` MANQUANTS, en écriture.
  # La lane de publication, elle, est en lecture seule — la CI ne fabrique
  # jamais de certificat.
  #
  # PRÉALABLE : l'App ID doit déjà porter ses capacités dans le portail Apple.
  # `match` provisionne des profils, il n'active PAS de capacités.
  desc "Crée les profils match manquants (mode écriture)"
  lane :provision do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      git_url: ENV["MATCH_GIT_URL"],
      api_key: api_key,
      readonly: false,
      force: false
    )
  end

  desc "IPA signé, envoyé sur TestFlight"
  lane :distribute do
    # Déverrouille le trousseau du runner. Sans lui, `match` importe le
    # certificat dans un trousseau verrouillé et `gym` échoue plus loin, sur un
    # message qui ne nomme ni le trousseau ni le certificat.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      git_url: ENV["MATCH_GIT_URL"],
      api_key: api_key,
      readonly: true
    )

    # La version marketing vient du tag, le numéro de build du compteur
    # d'exécution de la CI, qui est monotone. Les deux sont facultatifs : une
    # exécution locale garde ce que porte le projet.
    #
    # `agvtool` exige le projet en versionnement « Apple Generic » — le défaut
    # d'Expo. S'il répond « No values were found for versioning », c'est ce
    # réglage qu'il faut vérifier dans les Build Settings.
    unless ENV["MARKETING_VERSION"].to_s.empty?
      increment_version_number(
        version_number: ENV["MARKETING_VERSION"],
        xcodeproj: "ios/#{XCODE_PROJECT}"
      )
    end

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1",
      xcodeproj: "ios/#{XCODE_PROJECT}"
    )

    # Le WORKSPACE, jamais le projet nu : une application Expo a des Pods, et
    # archiver le projet seul les laisse dehors.
    gym(
      scheme: XCODE_SCHEME,
      workspace: "ios/#{XCODE_WORKSPACE}",
      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "TwakeVisio.ipa",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM='#{ENV["APPLE_TEAM_ID"]}' CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        teamID: ENV["APPLE_TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    # Envoi TestFlight INTERNE d'abord : immédiat, sans groupe externe ni revue
    # Beta. `distribute_external` et un groupe se rajoutent une fois les
    # informations de test remplies et la première revue passée — le mettre
    # aujourd'hui ferait échouer le tout premier envoi, celui qui compte.
    pilot(
      api_key: api_key,
      ipa: "ios/build/TwakeVisio.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
