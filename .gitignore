
.superpowers/

/android
/ios

# La sortie de Gradle du module natif local. `/android` est ANCRÉ — c'est ce qui
# fait que `modules/*/android/**` est bien suivi, et c'est voulu : le module y
# vit. Mais son `build/` est produit par `expo prebuild` + Gradle, au même titre
# que `/android` lui-même, et n'a rien à faire dans le dépôt.
modules/*/android/build/

.expo/
node_modules
*.log

# Les valeurs des secrets de publication, jamais dans git.
.release-secrets.env

# Sorties de fastlane : documentation régénérée à chaque lane, rapports
# d’exécution, et profils téléchargés par match. Rien de tout cela ne décrit
# une décision — tout est reproductible depuis le Fastfile.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
*.mobileprovision
